<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.apwanderlust</groupId>
    <artifactId>apwanderlust</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>AP Wanderlust</name>
    <description>Interactive Andhra Pradesh tourism guide — 26 districts, static HTML/CSS/JS packaged as a WAR.</description>

    <properties>
        <jdk.version>17</jdk.version>
        <maven.compiler.source>${jdk.version}</maven.compiler.source>
        <maven.compiler.target>${jdk.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Unused unless you add matching <dependencies> below — kept here
             only because the Jenkins job template expects them to exist. -->
        <spring.version>5.3.34</spring.version>
        <junit.version>4.11</junit.version>
        <log4j.version>1.2.17</log4j.version>

        <!-- SonarQube: prefer passing these as Jenkins credentials / -D flags
             instead of committing a password to source control, e.g.:
             mvn clean package sonar:sonar -Dsonar.login=$SONAR_TOKEN -->
        <sonar.host.url>http://3.92.0.234:9000/</sonar.host.url>
        <sonar.login>admin</sonar.login>
        <sonar.password>password</sonar.password>
    </properties>

    <build>
        <finalName>apwanderlust</finalName>
        <!-- This is a static site (no src/main/java). The WAR is built
             straight from the repo root — index.html, css/, js/ and
             WEB-INF/ — so the same folder works for GitHub Pages *and*
             `mvn package`. Only the site files are picked up; everything
             else (pom.xml, Dockerfile, deployment.yaml, README, .git) is
             excluded below. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warSourceDirectory>.</warSourceDirectory>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warSourceExcludes>
                        pom.xml,Dockerfile,deployment.yaml,README.md,.gitignore,target/**,.git/**,.github/**
                    </warSourceExcludes>
                </configuration>
            </plugin>
        </plugins>
             <plugin>
    <groupId>org.sonarsource.scanner.maven</groupId>
    <artifactId>sonar-maven-plugin</artifactId>
    <version>5.2.0.4988</version>
</plugin>
    </build>

</project>
